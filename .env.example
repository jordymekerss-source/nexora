# Set true for local demo without Supabase (file-backed store + seed data)
NEXT_PUBLIC_DEMO_MODE=true

# Public Supabase (required when DEMO_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only service role (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Absolute site URL used for auth redirects / invites
NEXT_PUBLIC_SITE_URL=http://localhost:3000
