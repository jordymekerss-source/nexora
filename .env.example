# Demo mode: explicit opt-in only. Never leave true in real production.
NEXT_PUBLIC_DEMO_MODE=true

# Required when running `next start` with DEMO_MODE=true (public demo hosts).
# Leave unset/false for real production tenants.
ALLOW_DEMO_IN_PRODUCTION=false

# Demo login accounts (only when DEMO_MODE=true):
# Medewerker: sam@nexora.local / nexora-demo-employee
# Werkgever:  demo@nexora.local / nexora-demo-employer

# Public Supabase (required when DEMO_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only service role (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Absolute site URL used for auth redirects / invites
NEXT_PUBLIC_SITE_URL=http://localhost:3000
