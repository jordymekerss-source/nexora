# Nginx site for NADS on Hetzner (TLS terminated here → 127.0.0.1:8787).
# Install as e.g. /etc/nginx/sites-available/nads
# Replace nads.example.com with your hostname.

limit_req_zone $binary_remote_addr zone=nads_webhooks:10m rate=5r/s;

upstream nads_ingress {
  server 127.0.0.1:8787;
  keepalive 16;
}

server {
  listen 80;
  listen [::]:80;
  server_name nads.example.com;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name nads.example.com;

  # Managed by Certbot (or fill manually):
  # ssl_certificate     /etc/letsencrypt/live/nads.example.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/nads.example.com/privkey.pem;
  # include /etc/letsencrypt/options-ssl-nginx.conf;
  # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  client_max_body_size 1m;

  location /health {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_pass http://nads_ingress;
  }

  location /ready {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_pass http://nads_ingress;
  }

  location /webhooks/ {
    limit_req zone=nads_webhooks burst=20 nodelay;

    # Preserve exact request body for GitHub HMAC (X-Hub-Signature-256).
    proxy_request_buffering on;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Content-Type $content_type;

    proxy_pass http://nads_ingress;
  }

  location / {
    return 404;
  }
}
