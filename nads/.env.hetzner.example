# Hetzner NADS env — placeholders only. Copy to .env.hetzner (gitignored) and fill secrets.
# NEVER commit real passwords, tokens, or webhook keys.

# --- Compose / Postgres (mandatory for this stack) ---
POSTGRES_USER=nads
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
POSTGRES_DB=nads
NADS_ENV_FILE=.env.hetzner
NADS_IMAGE=nexora-nads:hetzner

# --- Receive-only ingress (MANDATORY before first ingress-serve) ---
NADS_PRODUCTION=true
NADS_EXECUTOR=automation
NADS_AUTOMATION_ENABLED=false
NADS_INGRESS_ENABLED=true
NADS_ALLOW_CURSOR_API_SMOKE=false
NADS_WEBHOOK_RECEIPT_STORE=postgres
NADS_DISPATCH_STATE_STORE=postgres
NADS_REQUIRE_PG_RECEIPTS=true
NADS_INGRESS_HOST=0.0.0.0
NADS_INGRESS_PORT=8787
NADS_INGRESS_RATE_LIMIT=120
NADS_INGRESS_RATE_WINDOW_MS=60000

# Built by compose as postgresql://USER:PASSWORD@postgres:5432/DB — override only if needed.
# DATABASE_URL=

GITHUB_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_32
GITHUB_TOKEN=ghp_CHANGE_ME_or_fine_grained_pat
GITHUB_REPO=jordymekerss-source/nexora
NADS_REPO_URL=https://github.com/jordymekerss-source/nexora

# Reviewer (recommended for completion path; optional for /health smoke)
OPENAI_API_KEY=
NADS_OPENAI_MODEL=gpt-4o-mini
NADS_MODE=live

# --- One-shot activation protection (recommended for first live send) ---
NADS_SINGLE_TASK_MODE=true
NADS_APPROVED_TASK_ID=
NADS_ONE_SHOT_GATE_STORE=postgres

# --- Automation dispatch (OPTIONAL until first controlled send) ---
# Leave empty for receive-only. Required only when NADS_AUTOMATION_ENABLED=true.
NADS_AUTOMATION_WEBHOOK_URL=
NADS_AUTOMATION_WEBHOOK_KEY=
NADS_AUTOMATION_CALLBACK_SECRET=
NADS_AUTOMATION_TIMEOUT_MS=15000
NADS_AUTOMATION_MAX_RETRIES=2
NADS_AUTOMATION_BACKOFF_MS=250

# Public hostname used in docs / nginx (not read by NADS process)
NADS_PUBLIC_HOST=nads.example.com
