# NADS control plane — never commit real secrets
# Preferred architecture: NADS_EXECUTOR=automation (Cursor Automation webhook + GitHub completion)
# Optional fallback: NADS_EXECUTOR=cursor (Cloud Agents API — prepaid-gated; never auto-selected)

# Executor selection
# mock | automation | cursor  (production live path MUST be automation)
NADS_EXECUTOR=automation
# Hard gate for outbound Automation webhook POST (keep false until controlled staging)
NADS_AUTOMATION_ENABLED=false
NADS_AUTOMATION_WEBHOOK_URL=
NADS_AUTOMATION_WEBHOOK_KEY=
# Production fail-closed persistence (refuses memory/file receipt stores)
NADS_PRODUCTION=false
# Optional signed inbound callback (HMAC hex in X-NADS-Signature)
NADS_AUTOMATION_CALLBACK_SECRET=
# Outbound dispatch reliability (no /v1/agents)
NADS_AUTOMATION_TIMEOUT_MS=15000
NADS_AUTOMATION_MAX_RETRIES=2
NADS_AUTOMATION_BACKOFF_MS=250

# GitHub completion plane
GITHUB_TOKEN=
GITHUB_REPO=jordymekerss-source/nexora
GITHUB_WEBHOOK_SECRET=
GITHUB_INTEGRATION_BRANCH=cursor/integration
GITHUB_DEFAULT_BRANCH=main

# HTTP ingress (receive only — does not send Automations). Keep disabled unless intentionally hosting.
NADS_INGRESS_ENABLED=false
NADS_INGRESS_HOST=127.0.0.1
NADS_INGRESS_PORT=8787
NADS_INGRESS_MAX_BODY_BYTES=1048576
# memory | file | postgres
# Production multi-instance: postgres + DATABASE_URL (see docs/DATABASE.md).
# file is single-node only — not safe for multi-instance production.
# Never silently falls back from postgres → memory.
NADS_WEBHOOK_RECEIPT_STORE=memory
NADS_WEBHOOK_RECEIPT_PATH=
NADS_REQUIRE_PG_RECEIPTS=false
# Dispatch uncertain-state store (defaults to receipt store mode). Production: postgres.
NADS_DISPATCH_STATE_STORE=
NADS_DISPATCH_STATE_PATH=
# Completion lease TTL (ms); expired leases are recoverable after crashes
NADS_COMPLETION_LEASE_MS=900000
# In-process ingress rate limit (also configure reverse-proxy limits)
NADS_INGRESS_RATE_LIMIT=120
NADS_INGRESS_RATE_WINDOW_MS=60000

# OpenAI reviewer / planner (official openai Node SDK, server-side /nads only)
OPENAI_API_KEY=
NADS_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Optional Cursor Cloud Agents API fallback ONLY when NADS_EXECUTOR=cursor
# Do not enable prepaid auto top-up for NADS. Preferred path never calls POST /v1/agents.
CURSOR_API_KEY=
CURSOR_API_BASE_URL=https://api.cursor.com/v1
# Explicit opt-in for the optional cursor-smoke probe (calls POST /v1/agents)
NADS_ALLOW_CURSOR_API_SMOKE=false

# Reviewer mode (heuristic vs OpenAI) — independent of executor
NADS_MODE=dry-run

# Orchestrator
NADS_AUTONOMOUS_ENABLED=false
NADS_EMERGENCY_STOP=false
NADS_MAX_RETRIES=3
NADS_MAX_CONCURRENT_AGENTS=1
NADS_MAX_ITERATIONS=50
NADS_POLL_INTERVAL_MS=5000
NADS_RUN_TIMEOUT_MS=1800000
NADS_DAILY_BUDGET_USD=25
NADS_MONTHLY_BUDGET_USD=300
NADS_MAX_RUN_COST_USD=5

NADS_REPO_URL=https://github.com/jordymekerss-source/nexora
NADS_CURSOR_STARTING_REF=main
NADS_CURSOR_AUTO_CREATE_PR=false

# Control-plane database (required when NADS_WEBHOOK_RECEIPT_STORE=postgres).
# Apply migrations 001→004. Separate from SaaS Supabase.
DATABASE_URL=postgresql://nads:nads@localhost:5432/nads
# Set NADS_PG_INTEGRATION=1 to run real Postgres receipt/dispatch integration tests
NADS_PG_INTEGRATION=0
# Redis is NOT required by the Automation path (optional placeholder only)
REDIS_URL=
