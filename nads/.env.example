# NADS control plane — never commit real secrets

# Cursor Cloud Agents API (https://api.cursor.com/v1)
# Auth: Basic (API key as username, empty password) or Bearer
# Required when NADS_MODE=live — missing key fails closed (no mock fallback)
CURSOR_API_KEY=
CURSOR_API_BASE_URL=https://api.cursor.com/v1

# OpenAI reviewer / planner (official openai Node SDK, server-side only)
OPENAI_API_KEY=
# Verified model for this account; override if your org prefers another
NADS_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1

# GitHub (fine-scoped PAT or App token — least privilege)
# Prefer Cursor autoCreatePR for agent PRs to avoid duplicate PR creation.
GITHUB_TOKEN=
GITHUB_REPO=jordymekerss-source/nexora
GITHUB_INTEGRATION_BRANCH=cursor/integration
GITHUB_DEFAULT_BRANCH=main

# Orchestrator
NADS_AUTONOMOUS_ENABLED=false
NADS_EMERGENCY_STOP=false
NADS_MAX_RETRIES=3
NADS_MAX_CONCURRENT_AGENTS=1
NADS_MAX_ITERATIONS=50
NADS_POLL_INTERVAL_MS=5000
NADS_RUN_TIMEOUT_MS=1800000
NADS_DAILY_BUDGET_USD=25
NADS_MONTHLY_BUDGET_USD=300
NADS_MAX_RUN_COST_USD=5

# Live Cursor smoke / agent targeting
NADS_REPO_URL=https://github.com/jordymekerss-source/nexora
NADS_CURSOR_STARTING_REF=main
# Prefer false; set true only if Cursor should open the PR (do not also create via GitHub adapter)
NADS_CURSOR_AUTO_CREATE_PR=false

# Control-plane database (production). Omit for in-memory + .nads/execution-journal.json.
DATABASE_URL=postgres://nads:nads@localhost:5432/nads
REDIS_URL=redis://localhost:6379

# Mode: dry-run | live
# dry-run → HeuristicReviewer + MockCursor (no provider spend)
# live → requires CURSOR_API_KEY (fail closed) + OpenAIReviewer when OPENAI_API_KEY is set
NADS_MODE=dry-run
